// PTM search pipeline: Nextflow 25.10.2, DSL2.
// NOT LINTED: `nextflow lint` could not run in the build session (Nextflow
// dependency download was blocked). Run `nextflow lint .` on the cluster.
// No processes exist yet; this holds parameters and the cluster profile only.

params {
    // Cluster paths are given at run time (params file or -profile), never hardcoded.
    project_dir = null   // BeeGFS project directory (launch dir)
    publish_dir = null   // NFS publish directory; final outputs only, mode 'copy'
    accessions  = "${projectDir}/assets/accessions.txt"
}

profiles {
    slurm {
        process {
            executor       = 'slurm'
            queue          = 'defq'
            cpus           = 1
            memory         = '4 GB'
            clusterOptions = { "--ntasks=1 --cpus-per-task=${task.cpus}" }
            beforeScript   = 'module load singularity'
        }
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = "${launchDir}/.singularity/images"
        }
    }
}
