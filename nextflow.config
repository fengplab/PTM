// PTM search pipeline: Nextflow 25.10.2, DSL2.

params {
    // Cluster paths are given at run time (conf/params_cluster.yaml), never hardcoded.
    project_dir   = null   // BeeGFS project directory (launch dir)
    publish_dir   = null   // NFS publish directory; final outputs only, mode 'copy'
    accessions    = "${projectDir}/assets/accessions.txt"

    // Step 1 (intake)
    samplesheet   = null   // from bin/make_samplesheet.py
    batch         = null   // batch name; separates published outputs per batch
    max_downloads = 4      // concurrent PRIDE downloads (PRIDE rate-limits bursts)
    query_scans   = '1-1000'  // scans sampled per RAW file to read MS2/MS3 filter strings
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: 'DOWNLOAD_FILE' {
        cpus   = 1
        memory = '2 GB'
    }
    withName: 'RAW_METADATA' {
        cpus   = 1
        memory = '4 GB'
    }
    withName: 'SUMMARISE_RAWMETA' {
        cpus   = 1
        memory = '2 GB'
    }
}

profiles {
    slurm {
        process {
            executor       = 'slurm'
            queue          = 'defq'
            cpus           = 1
            memory         = '4 GB'
            clusterOptions = { "--ntasks=1 --cpus-per-task=${task.cpus}" }
            beforeScript   = 'module load singularity'
        }
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = "${launchDir}/.singularity/images"
        }
    }
    // Local stub runs only (no containers, no Slurm): nextflow run main.nf -profile test -stub-run ...
    test {
        process.executor = 'local'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.publish_dir}/step1/${params.batch}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.publish_dir}/step1/${params.batch}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.publish_dir}/step1/${params.batch}/pipeline_info/trace.tsv"
}
